# Copy to .env and fill in. Never commit .env.

# Database. Leave empty for local SQLite (pitchside_dev.db).
# Neon: use the pooled connection string, with the asyncpg driver prefix, e.g.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
DATABASE_URL=

# Required whenever DATABASE_URL is not SQLite. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of allowed browser origins (the deployed frontend URL).
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Live fixtures/standings: free key from https://www.football-data.org/client/register
# Leave empty to run without live data (pages show "not configured").
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
